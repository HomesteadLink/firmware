# HomeSteadyLink kill switch (§F4): table inet hsl.
# Forward from usb0 / wlan0 (AP) ONLY via the VPN interface; default drop.
# Applied by hsl-provisiond at startup before the VPN is raised; never removed.
table inet hsl {
	chain forward {
		type filter hook forward priority 0; policy drop;
		iifname "usb0" oifname "wg-hsl" accept
		iifname "usb0" oifname "tailscale0" accept
		iifname "wlan0" oifname "wg-hsl" accept
		iifname "wlan0" oifname "tailscale0" accept
		ct state established,related accept
	}
	chain input {
		type filter hook input priority 0; policy accept;
	}
}
