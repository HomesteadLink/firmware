[Unit]
Description=HomeSteadyLink UWE5622 Bluetooth attach (sprd, /dev/ttyS1)
After=dev-ttyS1.device
Wants=dev-ttyS1.device
Before=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
# §F2 fixes the attach: btattach with the sprd protocol on /dev/ttyS1,
# 5 retries. No fallback protocols (F17) — a wrong-protocol attach can
# wedge the UART. Success condition: /sys/class/bluetooth/hci0 exists.
ExecStart=/bin/sh -c 'for i in 1 2 3 4 5; do if [ -e /sys/class/bluetooth/hci0 ]; then exit 0; fi; btattach -B /dev/ttyS1 -P sprd 2>/dev/null || true; for j in 1 2 3 4; do [ -e /sys/class/bluetooth/hci0 ] && exit 0; sleep 0.5; done; sleep 2; done; [ -e /sys/class/bluetooth/hci0 ]'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
