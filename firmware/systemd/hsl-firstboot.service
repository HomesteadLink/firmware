[Unit]
Description=HomeSteadyLink first boot identity (serial + setup code)
Before=bluetooth.service hsl-provisiond.service serial-getty@ttyGS0.service
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/homesteadlink/bin/hsl-firstboot.sh

[Install]
WantedBy=multi-user.target
