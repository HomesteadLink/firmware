[Unit]
Description=HomeSteadyLink provisioning daemon (BLE GATT + USB WebUSB + Wi-Fi/VPN)
# §F2 service graph: After= only. provisiond must NOT Require
# hsl-bt-attach or bluetooth — it starts without hci0 and serves the
# config page / Wi-Fi apply path with BT dead (F8). The USB transport
# likewise only wants the gadget to exist first (it waits for
# /dev/ffs-usb/ep0 and binds the UDC itself); a missing gadget must
# not stop the BLE path.
After=bluetooth.service hsl-bt-attach.service hsl-firstboot.service network.target nftables.service usb-gadget.service
Wants=bluetooth.service hsl-firstboot.service nftables.service usb-gadget.service

[Service]
Type=simple
ExecStart=/opt/homesteadlink/bin/hsl-provisiond
Restart=on-failure
RestartSec=3
SyslogIdentifier=hsl-provisiond
# The daemon drives wpa_supplicant, systemctl, nft, wg/tailscale CLIs.
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
